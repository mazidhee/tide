{
  "name": "tide",
  "productName": "Tide",
  "version": "0.1.0",
  "description": "A local-first study app for your notes, sources and AI",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -w",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "npm run native && npm run pdfium && electron-vite build && electron-builder --mac --arm64 --publish never",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const d='node_modules/node-pty/prebuilds';if(fs.existsSync(d))for(const a of fs.readdirSync(d)){const f=p.join(d,a,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}\"",
    "check": "node scripts/check/run.mjs",
    "native": "cd native/tide-core && cargo build --release && cp target/release/libtide_core.dylib tide-core.node",
    "pdfium": "node scripts/fetch-pdfium.mjs"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "0.17.3",
    "@mozilla/readability": "^0.6.0",
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "jsonrepair": "3.15.0",
    "mammoth": "^1.9.1",
    "minisearch": "^7.1.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^5.3.31",
    "ts-fsrs": "^5.4.2",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.2",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@types/d3-force": "^3.0.10",
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "chess.js": "1.4.0",
    "d3-force": "^3.0.1",
    "dompurify": "^3.4.17",
    "electron": "42.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^4.0.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "mafs": "0.21.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.52.2",
    "planck": "1.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "regexp-tree": "0.1.27",
    "sql-formatter": "15.9.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "app.tide.study",
    "productName": "Tide",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "identity": null,
      "darkModeSupport": true
    },
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/pdfjs-dist/**"
    ],
    "dmg": {
      "title": "Tide",
      "artifactName": "Tide-${version}-arm64.${ext}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "protocols": [
      {
        "name": "Tide",
        "schemes": [
          "tide"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "native/tide-core/tide-core.node",
        "to": "tide-core.node"
      },
      {
        "from": "native/pdfium/libpdfium.dylib",
        "to": "libpdfium.dylib"
      },
      {
        "from": "native/pdfium/licenses",
        "to": "pdfium-licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "author": "mazidhee"
}
