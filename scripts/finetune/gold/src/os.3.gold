    n = min(ready, key=lambda n: rem[n])
    rem[n] -= 1
    t += 1
    if rem[n] == 0:
        del rem[n]
        done[n] = t
wait = {n: done[n] - a - b for n, (a, b) in jobs.items()}
assert done == {'P3': 4, 'P2': 7, 'P4': 9, 'P1': 16}
assert wait == {'P1': 7, 'P2': 1, 'P3': 0, 'P4': 0} and sum(wait.values()) / 4 == 2
</check>

<ask type="problem">The timeline, each job's waiting time, and the average waiting time.</ask>
@@ verify
def srtf(jobs):
    rem = {n: b for n, a, b in jobs}; arr = {n: a for n, a, b in jobs}; t = 0; done = {}; tl = []
    while rem:
        ready = sorted((n for n in rem if arr[n] <= t), key=lambda n: rem[n])
        assert len(ready) == 1 or rem[ready[0]] != rem[ready[1]], ('tie', t)   # no tie anywhere
        n = ready[0]
        if tl and tl[-1][0] == n: tl[-1][2] = t + 1
        else: tl.append([n, t, t + 1])
        rem[n] -= 1; t += 1
        if rem[n] == 0: del rem[n]; done[n] = t
    return done, ', '.join(f'{n} {a} to {b}' for n, a, b in tl)
def jobs_of(text):
    return [(r[0], int(r[1]), int(r[2])) for r in table(text)[1:]]
j1 = jobs_of(tutor[0])
done, tl = srtf(j1)
assert tl == 'P1 0 to 1, P2 1 to 3, P3 3 to 5, P2 5 to 8, P4 8 to 11, P1 11 to 18' and tl in solution(tutor[0])
assert done == {'P1': 18, 'P2': 8, 'P3': 5, 'P4': 11}
w = {n: done[n] - a - b for n, a, b in j1}
assert w == {'P1': 10, 'P2': 2, 'P3': 0, 'P4': 2} and sum(w.values()) / 4 == 3.5
# the learner's timeline is right and the one slip gives their 3.75
assert 'P1 18, P2 8, P3 5, P4 11' in learner and (10 + 3 + 0 + 2) / 4 == 3.75 and 8 - 5 == 3
# at 6: P2 has 2 left against P4's 3
assert 5 - (3 - 1) - (6 - 5) == 2
j2 = jobs_of(reply)
done2, tl2 = srtf(j2)
assert tl2 in solution(reply) and done2 == {'P1': 16, 'P2': 7, 'P3': 4, 'P4': 9}
w2 = {n: done2[n] - a - b for n, a, b in j2}
assert w2 == {'P1': 7, 'P2': 1, 'P3': 0, 'P4': 0} and sum(w2.values()) / 4 == 2

