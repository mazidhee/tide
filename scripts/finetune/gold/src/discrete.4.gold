assert 2**9 - 1 == 511 and 3 * 511 == 1533
assert 3**7 - 1 == 2186 and 5 * 2186 // 2 == 5465 == sum(5 * 3**k for k in range(7))
assert len(range(0, 7)) == 7 and len(range(0, 10)) == 10
# the note's formula on other values
from fractions import Fraction as F
for a in range(1, 5):
    for r in range(2, 6):
        for n in range(1, 9):
            assert sum(a * r**k for k in range(n)) == F(a * (r**n - 1), r - 1)
