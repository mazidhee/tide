assert run_py(block(reply, 'python')).strip() == '75025 49'
# the counts by an independent recurrence: naive calls C(n) = 1 + C(n-1) + C(n-2); memoised = 2n - 1
C = [1, 1]
for n in range(2, 26):
    C.append(1 + C[n - 1] + C[n - 2])
assert C[25] == 242785 and 2 * 25 - 1 == 49 and len(range(0, 26)) == 26
