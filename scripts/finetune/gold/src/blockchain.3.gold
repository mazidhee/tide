gwei = Fraction(1, 10 ** 9)
assert 90000 * 45 * gwei == Fraction(405, 100000)
assert 90000 * 40 * gwei == Fraction(36, 10000)
assert 90000 * 5 * gwei == Fraction(45, 100000)
</check>

<ask type="problem">The three amounts in ETH, each labelled burnt or paid to the proposer.</ask>
