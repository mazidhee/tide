assert 60000 * 3 == 180000 and eth(180000) == Fraction('0.00018')
assert 60000 * 25 == 1500000 and eth(1500000) == Fraction('0.0015')
assert eth(1500000) + eth(180000) == eth(1680000)
# problem 3
